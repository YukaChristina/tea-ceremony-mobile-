{
  "expo": {
    "name": "稽古記録",
    "slug": "tea-ceremony-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "teaceremony",
    "ios": {
      "supportsTablet": false,
      "requireFullScreen": true,
      "bundleIdentifier": "com.yukastudio.teaceremony",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f7f3ea",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.yukastudio.teaceremony",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "稽古の写真を選択するために写真へのアクセスが必要です。",
          "cameraPermission": "稽古の写真を撮影するためにカメラへのアクセスが必要です。"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "88173ea0-c79f-414a-bf3c-c6c808d51073"
      }
    },
    "owner": "yukachristina"
  }
}
